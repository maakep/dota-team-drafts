{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dota-draft-relay",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-16",
  "workers_dev": true,
  "vars": {
    "GITHUB_REPOSITORY": "maakep/dota-team-drafts",
    "ALLOWED_ORIGIN": "https://maakep.github.io"
  },
  "ratelimits": [
    { "name": "SAVE_LIMITER", "namespace_id": "19868001", "simple": { "limit": 10, "period": 60 } },
    { "name": "STATUS_LIMITER", "namespace_id": "19868002", "simple": { "limit": 120, "period": 60 } }
  ],
  "observability": { "enabled": false }
}
